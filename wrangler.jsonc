{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "decajobs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "decajob.com",
      "custom_domain": true
    },
    {
      "pattern": "www.decajob.com",
      "custom_domain": true
    }
  ]
}
